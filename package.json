{
  "name": "manekineko",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@manekineko/web --filter=@manekineko/landing-page",
    "dev:web": "npm run dev --workspace @manekineko/web",
    "dev:landing": "npm run dev --workspace @manekineko/landing-page",
    "build": "turbo run build",
    "build:web": "npm run build --workspace @manekineko/web",
    "build:landing": "npm run build --workspace @manekineko/landing-page",
    "landing:test": "npm run test --workspace @manekineko/landing-page && node --test scripts/setup-landing-newsletter.test.mjs",
    "contracts:compile": "npm run build --workspace @manekineko/contracts",
    "contracts:test": "npm run test --workspace @manekineko/contracts",
    "contracts:node": "npm run node --workspace @manekineko/contracts",
    "contracts:deploy:local": "npm run deploy:local --workspace @manekineko/contracts",
    "contracts:export": "npm run export --workspace @manekineko/contracts",
    "typecheck": "turbo run typecheck",
    "web:test": "npm run test --workspace @manekineko/web",
    "db:up": "docker-compose up -d database",
    "db:stop": "docker-compose stop database",
    "db:migrate": "node --env-file-if-exists=apps/web/.env.local scripts/database.mjs migrate",
    "db:seed": "node --env-file-if-exists=apps/web/.env.local scripts/database.mjs seed",
    "db:setup": "node --env-file-if-exists=apps/web/.env.local scripts/database.mjs setup",
    "db:test": "node --env-file-if-exists=apps/web/.env.local scripts/verify-history-database.mjs",
    "db:test:affiliates": "node --env-file-if-exists=apps/web/.env.local scripts/verify-affiliate-database.mjs",
    "db:prune:affiliates": "node --env-file-if-exists=apps/web/.env.local scripts/prune-affiliate-enrollment.mjs",
    "test": "npm run protocol:v17:rehearsal:test && npm run protocol:v17:social:test && npm run protocol:v16:rehearsal:test && npm run contracts:test && npm run web:test && npm run launch:test && npm run indexer:test && npm run credits:test && npm run eligibility:test && npm run landing:test",
    "check": "npm run test && npm run typecheck && npm run build",
    "dev:launch": "npm run dev --workspace @manekineko/launch",
    "dev:indexer": "npm run dev --workspace @manekineko/indexer",
    "build:indexer": "npm run build --workspace @manekineko/indexer",
    "indexer:test": "npm run test --workspace @manekineko/indexer",
    "build:launch": "npm run build --workspace @manekineko/launch",
    "launch:test": "npm run test --workspace @manekineko/launch && node --import tsx --test scripts/prepare-launch.test.mjs",
    "launch:account": "node --env-file-if-exists=apps/launch/.env.local scripts/launch-account.mjs",
    "launch:db:migrate": "node --env-file-if-exists=apps/launch/.env.local scripts/database.mjs migrate",
    "launch:prepare": "node scripts/prepare-launch.mjs",
    "launch:prepare:current": "node scripts/prepare-launch.mjs --expected-version affiliate-v10",
    "launch:db:test:auth": "node --env-file-if-exists=apps/launch/.env.local scripts/verify-launch-auth-database.mjs",
    "launch:db:test:config": "TEST_LAUNCH_DATABASE=1 node --env-file-if-exists=apps/launch/.env.local --experimental-strip-types --test apps/launch/test/launch-config-database.test.ts",
    "launch:db:test:automations": "TEST_LAUNCH_DATABASE=1 node --env-file-if-exists=apps/launch/.env.local --experimental-strip-types --test apps/launch/test/launch-automation-database.test.ts",
    "staging:check": "node scripts/staging-environment.mjs check",
    "staging:env": "node scripts/staging-environment.mjs export",
    "staging:db:check": "node scripts/staging-database.mjs check",
    "staging:db:provision": "node scripts/staging-database.mjs provision",
    "staging:providers:check": "node scripts/staging-provider-check.mjs",
    "staging:test": "node --test scripts/staging-*.test.mjs",
    "indexer:test:chain": "node --conditions=react-server --import tsx scripts/verify-indexer-chain.mjs",
    "credits:test": "node --import tsx --test scripts/winner-credit-*.test.mjs",
    "eligibility:test": "node --import tsx --test scripts/affiliate-eligibility-*.test.mjs",
    "season:run": "node --import tsx -- scripts/season-runner/cli.ts",
    "season:run:sepolia": "node --import tsx -- scripts/season-runner/sepolia.ts",
    "season:prepare:sepolia": "node --import tsx -- scripts/season-runner/prepare-sepolia.ts",
    "season:review:sepolia": "node --import tsx -- scripts/season-runner/review-season.ts",
    "season:review:refund-factory": "node --import tsx -- scripts/season-runner/review-refund-factory.ts",
    "season:recover:airy-garden": "node --import tsx -- scripts/season-runner/recover-airy-garden.ts",
    "season:settle:airy-prizes": "node --import tsx -- scripts/season-runner/settle-airy-prizes.ts",
    "season:resume:airy-garden": "node scripts/season-runner/resume-airy-garden.mjs",
    "season:run:mainnet": "node --import tsx -- scripts/season-runner/mainnet.ts",
    "season:test": "node --import tsx --test scripts/season-runner/*.test.ts",
    "season:typecheck": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions --resolveJsonModule --esModuleInterop --skipLibCheck scripts/season-runner/*.ts",
    "ui:source": "node --test scripts/visual/*.test.mjs && node scripts/visual/source-policy.mjs",
    "ui:typecheck": "tsc --project tests/visual/tsconfig.json",
    "ui:fixtures:build": "node scripts/visual/build.mjs",
    "ui:test": "playwright test",
    "ui:test:chromium": "playwright test --project=chromium",
    "ui:baselines": "playwright test --update-snapshots",
    "ui:check": "npm run ui:source && npm run ui:typecheck && node scripts/generate-tincta-brand.mjs --check && node --import tsx scripts/generate-landing-artwork.mjs --check && node --import tsx scripts/generate-rewards-machine-artwork.mjs --check && npm run ui:fixtures:build && npm run ui:test",
    "protocol:v12:prepare": "node scripts/protocol-v12/prepare.mjs",
    "protocol:v12:social": "node --import tsx scripts/protocol-v12/social.ts",
    "protocol:v12:test": "node --import tsx --test scripts/protocol-v12/*.test.*",
    "protocol:v12:executor": "node --import tsx scripts/protocol-v12/executor.mts",
    "protocol:v12:verify": "npm run contracts:compile && node --import tsx scripts/protocol-v12/verify-deployment.mts",
    "protocol:v12:previews": "node --import tsx scripts/protocol-v12/preview-social.mts",
    "protocol:v12:audit-bundle": "npm run contracts:compile && node scripts/protocol-v12/audit-bundle.mjs",
    "protocol:v12:rehearsal:build": "npm run contracts:compile && node --import tsx scripts/protocol-v12/rehearsal/build.mts",
    "protocol:v12:rehearsal:test": "npm run test --workspace @manekineko/contracts -- test/ProtocolV12Rehearsal.ts",
    "protocol:v13:verify": "npm run contracts:compile && node --import tsx scripts/protocol-v13/verify-deployment.mts",
    "protocol:v13:social": "node --import tsx scripts/protocol-v13/social.ts",
    "protocol:v13:executor": "node --import tsx scripts/protocol-v13/executor.mts",
    "protocol:v13:previews": "node --import tsx scripts/protocol-v12/preview-social.mts --v13",
    "protocol:workers:typecheck": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions --resolveJsonModule --esModuleInterop --skipLibCheck scripts/protocol-v12/runtime.ts scripts/protocol-v12/executor.mts scripts/protocol-v12/social.ts scripts/protocol-v12/preview-social.mts scripts/protocol-v13/executor.mts scripts/protocol-v13/social.ts scripts/protocol-v13/rehearsal/*.mts scripts/protocol-v14/*.mts scripts/protocol-v14/social.ts scripts/protocol-v14/rehearsal/*.mts",
    "protocol:v13:rehearsal:build": "npm run contracts:compile && node --import tsx scripts/protocol-v13/rehearsal/build.mts",
    "protocol:v13:rehearsal:test": "node --import tsx --test scripts/protocol-v13/rehearsal/rehearsal.test.mts && npm run test --workspace @manekineko/contracts -- test/ProtocolV13Rehearsal.ts",
    "protocol:v14:verify": "npm run contracts:compile && node --import tsx scripts/protocol-v14/verify-deployment.mts",
    "protocol:v14:test": "npm run test --workspace @manekineko/contracts -- test/ProtocolV14.ts",
    "protocol:v14:executor": "node --import tsx scripts/protocol-v14/executor.mts",
    "protocol:v14:social": "node --import tsx scripts/protocol-v14/social.ts",
    "protocol:v14:release-check": "npm run contracts:compile && node --import tsx scripts/protocol-v14/verify-deployment.mts",
    "protocol:v14:sources:test": "node --import tsx --test scripts/protocol-v14/source-publication.test.mts",
    "protocol:v14:sources": "node --import tsx scripts/protocol-v14/watch-sources.mts",
    "protocol:v14:rehearsal:build": "npm run contracts:compile && node --import tsx scripts/protocol-v14/rehearsal/build.mts",
    "protocol:v14:rehearsal:test": "node --import tsx --test scripts/protocol-v14/rehearsal/rehearsal.test.mts && npm run test --workspace @manekineko/contracts -- test/ProtocolV14Rehearsal.ts",
    "protocol:v14:deploy:sepolia": "npm run contracts:compile && node --import tsx scripts/protocol-v14/deploy-sepolia.mts",
    "protocol:v15:test": "npm run test --workspace @manekineko/contracts -- test/ProtocolV15.ts test/ProtocolV15Rehearsal.ts",
    "protocol:v16:test": "npm exec --workspace @manekineko/contracts -- hardhat test test/ProtocolV16.ts test/ProtocolV16Rehearsal.ts test/ProtocolV16Adapters.ts",
    "protocol:v16:rehearsal:test": "node --import tsx --test scripts/protocol-v16/rehearsal/rehearsal.test.mts && tsc -p scripts/protocol-v16/tsconfig.json",
    "protocol:v16:rehearsal:build": "node --import tsx scripts/protocol-v16/rehearsal/build.mts",
    "protocol:v16:release": "node --import tsx scripts/protocol-v16/release.mts",
    "protocol:v16:social": "node --import tsx scripts/protocol-v16/social.mts",
    "protocol:v16:social:test": "node --import tsx --test scripts/protocol-v16/social.test.ts scripts/protocol-v16/social-account.test.ts",
    "protocol:v17:test": "npm exec --workspace @manekineko/contracts -- hardhat test test/ProtocolV17.ts test/ProtocolV17Production.ts test/ProtocolV17Catalog.ts test/ProtocolV17Adapters.ts test/ProtocolV17Runner.ts",
    "protocol:v17:rehearsal:test": "node --import tsx --test scripts/protocol-v17/rehearsal/rehearsal.test.mts && tsc -p scripts/protocol-v17/tsconfig.json",
    "protocol:v17:rehearsal:build": "node --import tsx scripts/protocol-v17/rehearsal/build.mts",
    "protocol:v17:release": "node --import tsx scripts/protocol-v17/release.mts",
    "protocol:v17:social": "node --import tsx scripts/protocol-v17/social.mts",
    "protocol:v17:social:test": "node --import tsx --test scripts/protocol-v17/social.test.ts scripts/protocol-v16/social.test.ts scripts/protocol-v16/social-account.test.ts",
    "tincta:test": "npm exec --workspace @manekineko/contracts -- hardhat test test/TinctaRewards.ts test/TinctaCatalog.ts",
    "tincta:export": "npm run contracts:compile && node scripts/tincta/export.mjs",
    "tincta:verify": "node --import tsx scripts/tincta/verify.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2",
    "postcss": "8.5.6",
    "turbo": "2.10.12",
    "undici": "6.28.1"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "mocha": {
      "serialize-javascript": "7.1.1",
      "diff": "8.0.3"
    }
  }
}
