import {Contract,Transaction,type JsonRpcProvider} from 'ethers';
import abi from '../../../packages/contracts/src/ManekinekoV17.json' with {type:'json'};
import type {Plan} from './plan.mts';
import type {RunState} from './engine.mts';
import {auditBalances,auditScenario} from './audit.mts';
/** No keys, RPC URLs, raw signed bytes or explorer credentials enter the report. */
export async function report(plan:Plan,state:RunState,provider:JsonRpcProvider){
 const c=new Contract(plan.address,abi,provider),block=await provider.getBlock('latest');if(!block)throw new Error('Report anchor unavailable.');const at={blockTag:block.number};
 const prepared=Number(await c.prepared(at)),collections=[],liabilities=[];
 for(let id=1;id<=prepared;id++){
  const r=await c.round(id,at),t=await c.terms(id,at),scenario=plan.scenarios[id-1];
  const awards=[];if(r.finalizedAt>0n)for(let rank=0;rank<Number(t.winners);rank++){const global=(BigInt(id)<<17n)|r.winners[rank];awards.push({rank:rank+1,serial:String(r.winners[rank]),globalToken:String(global),owner:await c.ownerOf(global,at),beneficiary:await c.awardBeneficiary(global,at)});}
  const affiliates=await Promise.all(Array.from({length:10},(_,i)=>c.affiliates(id,i+1,at)));
  const terminal=r.finalizedAt>0n||await c.refundsAvailable(id,at);
  const expectedTerms=plan.options[scenario.choice],actual=r.finalizedAt?'sellout':terminal?'refund':'pending';
  const termsMatch=(['supply','price','winners','duration'] as const).every(key=>String(t[key])===expectedTerms[key]);
  const coverage=auditScenario({expected:scenario.outcome,actual,supply:BigInt(expectedTerms.supply),winners:BigInt(expectedTerms.winners),minted:r.minted,refunded:r.refunded,prizesClaimed:r.prizesClaimed,termsMatch});
  const liability={execution:BigInt(r.executionReserve),sponsorship:BigInt(r.sponsorReserve),principal:r.finalizedAt?0n:BigInt(r.revenue)-BigInt(r.refunded)*BigInt(t.price),
    prizes:r.finalizedAt?(BigInt(t.winners)-BigInt(r.prizesClaimed))*(r.revenue/10000n*(6000n/t.winners)):0n,
    affiliates:r.finalizedAt?affiliates.reduce((n,a)=>n+(a.referrals>0n&&!a.claimed?r.affiliateShare:0n),0n):0n,
    treasury:r.finalizedAt?r.revenue/10000n*(r.qualified===0n?3000n:1000n)-r.treasuryWithdrawn:0n,
    dust:r.finalizedAt&&r.qualified?r.revenue/10000n*2000n-BigInt(r.qualified)*BigInt(r.affiliateShare)-r.growthWithdrawn:0n};
  liabilities.push(liability);
  collections.push({id,name:scenario.name,expected:scenario.outcome,...coverage,termsMatch,settlementMode:scenario.automatedSettlement?'automated-wallets-only':'guided',actual,terminal,minted:String(r.minted),refunded:String(r.refunded),revenueWei:String(r.revenue),saleStart:String(r.saleStart),mintDeadline:String(await c.mintDeadline(id,at)),soldOutAt:String(r.soldOutAt),entropyAt:String(r.entropyAt),finalizedAt:String(r.finalizedAt),prizesClaimed:String(r.prizesClaimed),awards,affiliates:affiliates.map((a,i)=>({slot:i+1,wallet:a.wallet,referrals:String(a.referrals),claimed:a.claimed})),liabilityWei:Object.fromEntries(Object.entries(liability).map(([k,v])=>[k,String(v)]))});
 }
 const seasons=[];for(const seasonId of [...new Set(plan.scenarios.map(s=>s.seasonId))]){const s=await c.seasons(seasonId,at),h=await c.holderSummary(seasonId,at);seasons.push({seasonId,first:String(s.first),last:String(s.last),fundedWei:String(s.funded),paidWei:String(s.paid),eligibleNfts:String(s.eligible),claimLimit:String(h.limit),claims:String(s.claims),unlocked:h.unlocked});}
 const manual=[];for(const[address,custody]of Object.entries(state.custody))manual.push({address,index:state.addresses.findIndex(a=>a.toLowerCase()===address),...custody,balanceWei:String(await provider.getBalance(address,block.number))});
 const operating=await c.operatingReserve(at),accounted=await c.accountedBalance(at),balance=await provider.getBalance(plan.address,block.number);
 const holderLiability=seasons.reduce((n,s)=>n+BigInt(s.fundedWei)-BigInt(s.paidWei),0n);
 const accounting=auditBalances({accounted,balance,operating,holders:holderLiability,collections:liabilities});
 const transactions=Object.entries(state.journals).flatMap(([actor,j])=>j.transactions.map(e=>{const t=Transaction.from(e.rawTransaction);return{actor:Number(actor),action:e.action,hash:e.hash,status:e.state,block:e.blockNumber,from:j.from,to:t.to,valueWei:String(t.value),gasUsed:e.gasUsed,gasPriceWei:e.gasPrice};}));
 const executionPassed=state.complete&&accounting.passed&&collections.length===6&&collections.every(x=>x.terminal&&x.scenarioPassed)&&seasons.every(s=>s.claims===s.claimLimit)&&liabilities.every(c=>Object.values(c).every(n=>n===0n))&&state.errors.length===0;
 return{version:17,network:'Sepolia',chainId:11155111,contract:plan.address,codeHash:plan.codeHash,planHash:state.planHash,continuation:plan.continuation??null,extraRandomnessFundingWei:state.extraRandomnessFundingWei??{},at:new Date().toISOString(),block:block.number,blockHash:block.hash,started:state.started,complete:state.complete,executionPassed,mainnetReady:false,accounting,sealed:await c.catalogSealed(at),genesisMints:String((await c.round(0,at)).minted),catalogCollections:plan.scenarios.length,preparedCollections:prepared,bank:state.addresses[plan.bankIndex],bankBalanceWei:String(await provider.getBalance(state.addresses[plan.bankIndex],block.number)),externalFundingWei:String(state.funding.reduce((n,p)=>n+BigInt(p.value),0n)),gasWei:state.gasWei,knownVrfFeesWei:state.vrfFeesWei,contractAccountedWei:String(accounted),operatorProtectedBaselineWei:state.operatorBaseline,manualWallets:manual,currentCheckpoint:state.gate,manualTests:state.approvals,failedManualTransactions:state.failedManualTransactions??[],retiredTransactions:state.retiredTransactions??[],errors:state.errors,incidentOverrides:state.overrides??{},costReviews:state.costReviews??[],coverageLimits:plan.coverageLimits,collections,seasons,transactions};
}

export function renderReport(r:Awaited<ReturnType<typeof report>>){
 return `# V17 accelerated Sepolia rehearsal report\n\nStatus: **${r.complete?(r.executionPassed?'EXECUTION PASSED; READINESS REVIEW REQUIRED':'COMPLETE WITH ERRORS'):r.started?'IN PROGRESS':'PREPARED; NOT STARTED'}**. Mainnet ready: **No**.\n\nObserved ${r.at}, block ${r.block} (${r.blockHash}).\n\nContract: [${r.contract}](https://sepolia.etherscan.io/address/${r.contract}). Plan: \`${r.planHash}\`.\n\n## Actual live outcomes\n\n| ID | Collection | Planned | Actual | Minted / planned | Refunded | Prizes claimed | Scenario |\n|---|---|---|---|---:|---:|---:|---|\n${r.collections.map(c=>`| ${c.id} | ${c.name} | ${c.expected} | ${c.actual} | ${c.minted} / ${c.expectedMinted} | ${c.refunded} | ${c.prizesClaimed} | ${c.scenarioPassed?'PASS':'FAILED / incomplete'} |`).join('\n')}\n\n## Accounting\n\nIndependent liability reconstruction: **${r.accounting.passed?'balanced':'FAILED'}**. Accounted ${r.accounting.accountedWei} wei; reconstructed ${r.accounting.expectedLiabilityWei} wei; contract ${r.accounting.contractBalanceWei} wei. Gas ${r.gasWei} wei; known VRF fees ${r.knownVrfFeesWei} wei; external funding ${r.externalFundingWei} wei.\n\n## Manual wallet evidence\n\n${Object.entries(r.manualTests).map(([id,a])=>`- ${id}: ${a.note.replace(/[\r\n]+/g,' ')}${a.transaction?` — [receipt](https://sepolia.etherscan.io/tx/${a.transaction})`:''}`).join('\n')||'No manual tests completed.'}\n\n## Errors and incidents\n\n${r.errors.map(e=>`- Collection ${e.collection}: ${e.code} (${e.at})`).join('\n')||'No recorded errors. This does not certify untested paths.'}\n\n## Evidence limits and Mainnet requirements\n\n${r.coverageLimits.map(x=>'- '+x).join('\n')}\n- Exact production settings and bytecode require a separate release review. The approximately 40 KB runtime requires explicit verification of the target network code-size rules; local unlimited-size EVM tests are not deployment qualification.\n- User-observed UI/device tests, independent security review and every unresolved defect remain separate acceptance items.\n- Remaining human-wallet funds and protected contract liabilities are listed in report.json. Gas and eligible holder division dust are not silently classified as lost funds.\n`;
}
