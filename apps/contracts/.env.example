# Hardhat reads process environment or its encrypted keystore.
# This example is not loaded automatically. Never expose keys to either Next.js app.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
MAINNET_RPC_URL=https://your-mainnet-rpc.example
DEPLOYER_PRIVATE_KEY=
# Paths are relative to apps/contracts when using npm workspace scripts.
ROUND_CONFIG_PATH=./round.example.json
# Optional: existing matching factory, for next-round deployment after successful payout.
FACTORY_ADDRESS=
# V2 tooling uses an explicit config and defaults to read-only preflight.
V2_CONFIG_PATH=./round-v2.sepolia.example.json
V2_PREFLIGHT_FROM=
V2_BROADCAST=0
ETHERSCAN_API_KEY=
V2_JOURNAL_PATH=
# Affiliate-enabled V3. Deployment leaves enrollment open until separate owner activation.
V3_CONFIG_PATH=./round-v3.sepolia.example.json
V3_PREFLIGHT_FROM=
V3_BROADCAST=0
V3_JOURNAL_PATH=
# Configurable prize and per-position referral rates; frozen on deployment.
V4_CONFIG_PATH=./round-v4.sepolia.example.json
V4_PREFLIGHT_FROM=
V4_BROADCAST=0
V4_JOURNAL_PATH=

# Shared affiliate pool, distributed by referred sales at sellout.
V5_CONFIG_PATH=./round-v5.sepolia.example.json
V5_PREFLIGHT_FROM=
V5_BROADCAST=0
V5_JOURNAL_PATH=

# Current V10 tooling. Use round-v10.json produced from a finalized Launch export.
# Keep all addresses/hashes blank until independently verified for this network.
V10_CONFIG_PATH=
V10_PREFLIGHT_FROM=
V10_BROADCAST=0
V10_JOURNAL_PATH=
V10_MAX_FEE_PER_GAS_WEI=
V10_AFFILIATE_ELIGIBILITY_ADDRESS=
AFFILIATE_ELIGIBILITY_V5_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V5_CODEHASH_11155111=
# Mainnet configuration is separate and is not inherited from Sepolia.
AFFILIATE_ELIGIBILITY_V5_ADDRESS_1=
AFFILIATE_ELIGIBILITY_V5_CODEHASH_1=
