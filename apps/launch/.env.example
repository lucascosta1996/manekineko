# Launch V12 uses wallet authorization and direct public chain reads.
# No database password, server signing key or Launch login is required.
# Leave each network unset until its reviewed deployment has been verified.
NEXT_PUBLIC_V12_MAINNET_CONTROLLER=
NEXT_PUBLIC_V12_MAINNET_CONTROLLER_CODE_HASH=
NEXT_PUBLIC_V12_MAINNET_RPC_URL=
NEXT_PUBLIC_V12_MAINNET_WS_URL=
NEXT_PUBLIC_V12_SEPOLIA_CONTROLLER=
NEXT_PUBLIC_V12_SEPOLIA_CONTROLLER_CODE_HASH=
NEXT_PUBLIC_V12_SEPOLIA_RPC_URL=
NEXT_PUBLIC_V12_SEPOLIA_WS_URL=
# HTTPS/WSS public endpoints only. These values are sent to the browser.
# Optional mobile wallet connection; register the deployed Launch origin with the provider.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
