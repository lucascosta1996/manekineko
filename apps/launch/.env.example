# The launch application uses its own Vercel project and server environment.
# Use the existing local database for development. Never use the migration owner as a production app role.
DATABASE_URL=postgresql://manekineko:manekineko-local-only@127.0.0.1:54329/manekineko
LAUNCH_PUBLIC_ORIGIN=http://localhost:3200
# Set to 11155111 in staging: Mainnet drafts, preparation and exports are rejected.
# MANEKINEKO_CHAIN_ID=11155111

# In production use an exact HTTPS origin, for example https://launch.example.com.
# Provision accounts with npm run launch:account. Passwords and blockchain signing keys are never app environment variables.

# Required in production. Generate a server-only random value of at least 32 characters.
# LAUNCH_RATE_LIMIT_SECRET=
