# Server-only PostgreSQL connection. History always reads the database.
# Local Docker database (compose.yaml); never use this password in production.
# Copy to .env.local, then run npm run db:setup from the repository root.
DATABASE_URL=postgresql://manekineko:manekineko-local-only@127.0.0.1:54329/manekineko
# Set to 11155111 in the isolated Sepolia staging project. Omit for the existing multi-chain catalog.
# MANEKINEKO_CHAIN_ID=11155111

# Automated affiliate enrollment. Leave empty for the database-backed demo.
# Public HTTPS origin for live enrollment and share links.
# Balance reads and existing withdrawals work without enrollment credentials.
# On localhost, this can point to the official hosted site for share links;
# do not spoof VERCEL or proxy headers to enable local enrollment.
AFFILIATE_PUBLIC_ORIGIN=
# Live enrollment requires a direct Vercel edge deployment; arbitrary client IP headers are not trusted.
AFFILIATE_TRUSTED_PROXY=vercel
# Server-only random secret (at least 32 characters) for short-lived IP abuse keys.
AFFILIATE_IP_HASH_SECRET=
# Separate, unfunded enrollment key matching each live round's immutable enrollmentSigner.
# Never use the contract owner/deployer key or a NEXT_PUBLIC prefix here.
AFFILIATE_ENROLLMENT_PRIVATE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only RPC endpoints. Live reads are verified against the published factory.
AFFILIATE_RPC_URL_1=
AFFILIATE_RPC_URL_11155111=
AFFILIATE_TRUSTED_FACTORY_1=
AFFILIATE_TRUSTED_FACTORY_11155111=
# Actual deployed runtime hashes from the V3 deployment journal, including renderer immutable.
AFFILIATE_TRUSTED_FACTORY_CODEHASH_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_11155111=
# V4 pins are separate so historical V3 programs remain usable.
# Take hashes from a verified V4 journal after checking factory, renderer and deployment helper.
AFFILIATE_TRUSTED_FACTORY_V4_1=
AFFILIATE_TRUSTED_FACTORY_V4_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V4_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V4_11155111=

# V5 shared-pool factories: pin separately from historical V3/V4 factories.
AFFILIATE_TRUSTED_FACTORY_V5_1=
AFFILIATE_TRUSTED_FACTORY_V5_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V5_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V5_11155111=

# V6 encoded-rank factories: V5 pins never authorize a V6 deployment.
AFFILIATE_TRUSTED_FACTORY_V6_1=
AFFILIATE_TRUSTED_FACTORY_V6_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V6_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V6_11155111=

# Canonical V6 affiliate NFT-holder eligibility gate; configure address and
# verified deployed runtime hash together. Only global sequence one is open
# bootstrap. Later enrollment requires an earlier completed official NFT.
AFFILIATE_ELIGIBILITY_ADDRESS_1=
AFFILIATE_ELIGIBILITY_CODEHASH_1=
AFFILIATE_ELIGIBILITY_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_CODEHASH_11155111=

# V7 ranked prizes and qualified equal affiliates require independent deployment pins.
AFFILIATE_TRUSTED_FACTORY_V7_1=
AFFILIATE_TRUSTED_FACTORY_V7_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V7_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V7_11155111=
AFFILIATE_ELIGIBILITY_V2_ADDRESS_1=
AFFILIATE_ELIGIBILITY_V2_CODEHASH_1=
AFFILIATE_ELIGIBILITY_V2_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V2_CODEHASH_11155111=

# Active winner-credit V3 registry with a V2 predecessor: independently pin the
# immutable predecessor too, to preserve already-used lifetime rewards.
WINNER_CREDITS_PREVIOUS_ADDRESS_1=
WINNER_CREDITS_PREVIOUS_CODEHASH_1=
WINNER_CREDITS_PREVIOUS_ADDRESS_11155111=
WINNER_CREDITS_PREVIOUS_CODEHASH_11155111=
# Only for a V4 -> V3 -> V2 migration: independently pin the V2 ancestor too.
WINNER_CREDITS_ANCESTOR_ADDRESS_1=
WINNER_CREDITS_ANCESTOR_CODEHASH_1=
WINNER_CREDITS_ANCESTOR_ADDRESS_11155111=
WINNER_CREDITS_ANCESTOR_CODEHASH_11155111=

# V8 six-equal-prize collections use independent deployment and eligibility pins.
AFFILIATE_TRUSTED_FACTORY_V8_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V8_11155111=
AFFILIATE_TRUSTED_FACTORY_V8_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V8_1=
AFFILIATE_ELIGIBILITY_V3_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V3_CODEHASH_11155111=
AFFILIATE_ELIGIBILITY_V3_ADDRESS_1=
AFFILIATE_ELIGIBILITY_V3_CODEHASH_1=

# Historical V9 factories and Eligibility V4: pins must match independently verified deployments.
AFFILIATE_TRUSTED_FACTORY_V9_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V9_1=
AFFILIATE_TRUSTED_FACTORY_V9_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V9_11155111=
AFFILIATE_ELIGIBILITY_V4_ADDRESS_1=
AFFILIATE_ELIGIBILITY_V4_CODEHASH_1=
AFFILIATE_ELIGIBILITY_V4_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V4_CODEHASH_11155111=

# V10 requires its own factory and Eligibility V5. Existing V9 pins cannot be reused.
AFFILIATE_TRUSTED_FACTORY_V10_1=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V10_1=
AFFILIATE_TRUSTED_FACTORY_V10_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V10_11155111=
AFFILIATE_ELIGIBILITY_V5_ADDRESS_1=
AFFILIATE_ELIGIBILITY_V5_CODEHASH_1=
AFFILIATE_ELIGIBILITY_V5_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V5_CODEHASH_11155111=

# Additional independently verified lineage when the active registry is Winner Credits V5/V6.
# PREVIOUS is the direct parent, ANCESTOR its parent, then ANCESTOR_2 and ANCESTOR_3.
# V6 also requires matching legacy roots and zero sponsorship in every previous registry.
WINNER_CREDITS_ANCESTOR_2_ADDRESS_1=
WINNER_CREDITS_ANCESTOR_2_CODEHASH_1=
WINNER_CREDITS_ANCESTOR_2_ADDRESS_11155111=
WINNER_CREDITS_ANCESTOR_2_CODEHASH_11155111=
WINNER_CREDITS_ANCESTOR_3_ADDRESS_1=
WINNER_CREDITS_ANCESTOR_3_CODEHASH_1=
WINNER_CREDITS_ANCESTOR_3_ADDRESS_11155111=
WINNER_CREDITS_ANCESTOR_3_CODEHASH_11155111=
