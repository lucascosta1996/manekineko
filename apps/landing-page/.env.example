# Public URL used for the optional app footer link and collection destinations.
# The Rewards navbar Open app button always points to https://app.tincta.xyz.
# Development defaults to http://localhost:3100.
NEXT_PUBLIC_WEB_URL=

# Deployment routing: studio serves the parent at / and redirects /rewards to
# the separate Rewards site; rewards keeps the Rewards experience at /.
# Leave unset locally to serve the parent at / and Rewards at /rewards.
LANDING_SITE_ROLE=
REWARDS_PUBLIC_URL=https://rewards.tincta.xyz

# Server-only newsletter storage. Use a dedicated restricted PostgreSQL login;
# migration 028 defines the tables and required narrow grants.
NEWSLETTER_DATABASE_URL=
# Canonical HTTPS origin for a nonstandard deployment. The public Rewards domain
# and its two parent-site callers are built in; old preview aliases cannot block them.
NEWSLETTER_PUBLIC_ORIGIN=
# Explicit opt-in for `next start` on loopback only; never enabled on Vercel.
NEWSLETTER_ALLOW_LOCAL_PREVIEW=
# At least 32 random characters; hashes network addresses for short-lived quotas.
NEWSLETTER_IP_HASH_SECRET=

# Public footer destinations. Use the matching deployed environment; unset links show Awaiting URL.
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_TELEGRAM_URL=
# Public X profiles are defined per brand in packages/ui/src/links.ts.
