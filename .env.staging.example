# Copy to .env.staging.local with mode 0600. Never commit real values.
# Dedicated Vercel projects use their production target for stable STAGING URLs.
MANEKINEKO_CHAIN_ID=11155111
STAGING_WEB_PROJECT=manekineko-staging-web
STAGING_LAUNCH_PROJECT=manekineko-staging-launch
AFFILIATE_PUBLIC_ORIGIN=https://manekineko-staging-web.vercel.app
LAUNCH_PUBLIC_ORIGIN=https://manekineko-staging-launch.vercel.app

# Dedicated empty remote PostgreSQL database; direct connections, verified TLS.
# Expected host/name and UUID bind provisioning to this staging database only.
STAGING_DATABASE_EXPECTED_HOST=
STAGING_DATABASE_EXPECTED_NAME=
STAGING_DATABASE_ID=
DATABASE_ADMIN_URL=
WEB_DATABASE_URL=
LAUNCH_DATABASE_URL=

# Separate randomly generated secrets. No deployer key belongs in either app.
AFFILIATE_TRUSTED_PROXY=vercel
AFFILIATE_IP_HASH_SECRET=
AFFILIATE_ENROLLMENT_PRIVATE_KEY=
LAUNCH_RATE_LIMIT_SECRET=

# Real widget restricted to the staging web hostname; never use dummy test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private provider URL; replace this example with your actual Sepolia endpoint.
AFFILIATE_RPC_URL_11155111=https://your-endpoint.ethereum-sepolia.quiknode.pro/your-endpoint-token/
SEPOLIA_RPC_URL=https://your-endpoint.ethereum-sepolia.quiknode.pro/your-endpoint-token/
# Set both RPC variables to the same private Sepolia endpoint for provider qualification.
# Verification credential stays in the local contract tooling; not exported to Vercel apps.
ETHERSCAN_API_KEY=
# Leave pins unset until the V5 factory is deployed and verified in the next stage.
AFFILIATE_TRUSTED_FACTORY_V5_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V5_11155111=
V5_BROADCAST=0
# V6 requires its own newly deployed and verified factory; never copy V5 pins.
AFFILIATE_TRUSTED_FACTORY_V6_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V6_11155111=
V6_BROADCAST=0
# V7 and V8 each require independently deployed and verified factory pins.
AFFILIATE_TRUSTED_FACTORY_V7_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V7_11155111=
AFFILIATE_TRUSTED_FACTORY_V8_11155111=
AFFILIATE_TRUSTED_FACTORY_CODEHASH_V8_11155111=
# Current canonical registry per chain. Configure only after verification.
WINNER_CREDITS_ADDRESS_11155111=
WINNER_CREDITS_CODEHASH_11155111=
# Pin the actual predecessor lineage, when present, to preserve lifetime credit use.
# A V4 -> V3 -> V2 lineage uses PREVIOUS for V3 and ANCESTOR for V2.
# Set each address/hash pair together; PREVIOUS requires the current registry,
# and ANCESTOR requires PREVIOUS. Never copy a different registry's pins.
WINNER_CREDITS_PREVIOUS_ADDRESS_11155111=
WINNER_CREDITS_PREVIOUS_CODEHASH_11155111=
WINNER_CREDITS_ANCESTOR_ADDRESS_11155111=
WINNER_CREDITS_ANCESTOR_CODEHASH_11155111=
# Separate canonical holder-eligibility registry. Its first collection alone has open enrollment.
AFFILIATE_ELIGIBILITY_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_CODEHASH_11155111=
# V7 uses eligibility V2; V8 uses eligibility V3. Leave each pair unset until verified.
AFFILIATE_ELIGIBILITY_V2_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V2_CODEHASH_11155111=
AFFILIATE_ELIGIBILITY_V3_ADDRESS_11155111=
AFFILIATE_ELIGIBILITY_V3_CODEHASH_11155111=
# Must match the finalized launch operations and the canonical address above.
V6_AFFILIATE_ELIGIBILITY_ADDRESS=
